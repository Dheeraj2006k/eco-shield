# Vercel / local web env. Copy to apps/web/.env.local for local runs (npm run gen-env does it for you).

# >= 32 random chars; must equal the API's value if you host one
IRIS_AUTH_SECRET=
# admin|ADMIN|password,operator|OPERATOR|password,...
IRIS_USERS=

# Optional - only when you host the FastAPI backend (see docs/DEPLOYMENT.md), e.g. https://eco-shield-api.onrender.com
NEXT_PUBLIC_API_URL=
# "remote" starts on the backend; empty = local in-browser engine
NEXT_PUBLIC_DEFAULT_SOURCE=
