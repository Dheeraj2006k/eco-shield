# Copy to .env (git-ignored) and fill in EVERY value. Never commit real secrets.
# `npm run gen-env` generates strong random values for local (non-Docker) development instead.

# --- Auth (shared by web + api) ---
# ≥ 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
IRIS_AUTH_SECRET='Dheeraj'
# username|ROLE|password, comma separated. ROLE ∈ ADMIN, AUTHORITY, OPERATOR, FIELD_STEWARD, VIEWER
# (demo-grade credential store; replace with an IdP / hashed DB users for real deployments)
IRIS_USERS=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# 'remote' starts on the backend API; empty = local in-browser engine
NEXT_PUBLIC_DEFAULT_SOURCE=
# 1 only for plain-http local use; remove behind HTTPS
IRIS_INSECURE_COOKIES=1

# --- API ---
IRIS_CORS_ORIGINS=http://localhost:3000
IRIS_MQTT_ENABLED=false
IRIS_MQTT_PASSWORD=
# SQLite file for incidents/tickets; ':memory:' disables persistence. Ignored if DATABASE_URL is set.
IRIS_DB_PATH=/srv/iris_state.db
# Optional: a Postgres connection string (e.g. from Supabase) — takes priority over IRIS_DB_PATH.
# Supabase: Project Settings -> Database -> Connection string -> URI (use the *direct* connection,
# not the pooler, since the API holds a long-lived connection).
DATABASE_URL=

# --- Infrastructure ---
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
