# Copy to .env (git-ignored) and fill in EVERY value. Never commit real secrets.
# `npm run gen-env` generates strong random values for local (non-Docker) development instead.

# --- Auth (shared by web + api) ---
# ≥ 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
IRIS_AUTH_SECRET=
# username|ROLE|password, comma separated. ROLE ∈ ADMIN, AUTHORITY, OPERATOR, FIELD_STEWARD, VIEWER
# (demo-grade credential store; replace with an IdP / hashed DB users for real deployments)
IRIS_USERS=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
IRIS_INSECURE_COOKIES=1        # set to 0 (or remove) when serving over HTTPS

# --- API ---
IRIS_CORS_ORIGINS=http://localhost:3000
IRIS_MQTT_ENABLED=false
IRIS_MQTT_PASSWORD=

# --- Infrastructure ---
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
